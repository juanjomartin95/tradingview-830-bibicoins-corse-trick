//@version=6
indicator("Vela 8:30 → TP ±100 pts", shorttitle = "TP 8:30", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────
//  Detecta la vela de 8:30–8:35 (gráfico de 5 min).
//  · Si cierra ALCISTA  → TP = cierre + X puntos
//  · Si cierra BAJISTA  → TP = cierre − X puntos
//  Pinta la línea del TP, la etiqueta con el número, una tabla
//  de resumen y lanza un aviso en cuanto cierra la vela.
//
//  IMPORTANTE: pon el gráfico en 5 min y ajusta la ZONA HORARIA
//  para que "8:30" sea la hora que tú quieres.
// ─────────────────────────────────────────────────────────────

// ══ ENTRADAS · Configuración ═════════════════════════════════
gCfg  = "Configuración"
tHour = input.int(8,  "Hora de la vela",   minval = 0, maxval = 23, group = gCfg)
tMin  = input.int(30, "Minuto de la vela", minval = 0, maxval = 59, group = gCfg)
tz    = input.string("Europe/Madrid", "Zona horaria", options = ["Europe/Madrid", "Europe/London", "America/New_York", "UTC"], group = gCfg)
pts   = input.float(100, "Puntos para el TP", minval = 0, group = gCfg)

// ══ ENTRADAS · Visual ════════════════════════════════════════
gView       = "Visual"
extendH     = input.int(13, "Horas que se extiende la línea", minval = 1, maxval = 48, group = gView)
showEntry   = input.bool(true,  "Mostrar línea de entrada (cierre 8:30)", group = gView)
showHistory = input.bool(false, "Mostrar días anteriores (historial)",    group = gView)
showTable   = input.bool(true,  "Mostrar tabla de resumen",               group = gView)
colBull     = input.color(#0f9d4f, "Color alcista", group = gView)
colBear     = input.color(#e0454a, "Color bajista", group = gView)

// ══ DETECCIÓN DE LA VELA ═════════════════════════════════════
is5min   = timeframe.period == "5"
hh       = hour(time, tz)
mm       = minute(time, tz)
isTarget = hh == tHour and mm == tMin
extendMs = extendH * 60 * 60 * 1000

// memoria para la tabla (la dirección se deduce de TP vs cierre)
var float vClose = na
var float vTp    = na

// referencias para poder borrar el día anterior si no hay historial
var line  lnTp = na
var line  lnEn = na
var label lbTp = na
var label lbEn = na

if isTarget and barstate.isconfirmed and is5min
    isBull = close >= open                       // doji (raro) se cuenta como alcista
    tp     = isBull ? close + pts : close - pts
    col    = isBull ? colBull : colBear
    x1     = time
    x2     = time + extendMs

    if not showHistory
        line.delete(lnTp)
        line.delete(lnEn)
        label.delete(lbTp)
        label.delete(lbEn)

    // línea de entrada (cierre de la vela)
    lnEn := showEntry ? line.new(x1, close, x2, close, xloc = xloc.bar_time, color = color.new(color.gray, 20), style = line.style_dotted, width = 1) : na
    lbEn := showEntry ? label.new(x2, close, "Entrada " + str.tostring(close, format.mintick), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.gray, 20), textcolor = color.white, size = size.small) : na

    // línea del TP
    lnTp := line.new(x1, tp, x2, tp, xloc = xloc.bar_time, color = col, style = line.style_solid, width = 2)
    lbTp := label.new(x2, tp, "TP " + str.tostring(tp, format.mintick) + (isBull ? "  ▲" : "  ▼"), xloc = xloc.bar_time, style = label.style_label_left, color = col, textcolor = color.white, size = size.normal)

    // guardar para la tabla
    vClose := close
    vTp    := tp

    // aviso (para recibir el número en cuanto cierra la vela)
    alert("Vela " + str.tostring(tHour) + ":" + str.tostring(tMin) + (isBull ? " ALCISTA ▲" : " BAJISTA ▼") + "  |  Cierre: " + str.tostring(close, format.mintick) + "  |  TP: " + str.tostring(tp, format.mintick), alert.freq_once_per_bar)

// ══ TABLA DE RESUMEN (esquina superior derecha) ══════════════
var table t = table.new(position.top_right, 2, 4, bgcolor = color.new(#101418, 8), frame_color = color.new(color.gray, 40), frame_width = 1, border_color = color.new(color.gray, 65), border_width = 1)

if showTable and barstate.islast
    hasData   = not na(vTp)
    isBullNow = hasData and vTp >= vClose
    dirTxt    = not hasData ? "—" : (isBullNow ? "ALCISTA ▲" : "BAJISTA ▼")
    dirCol    = not hasData ? color.gray : (isBullNow ? colBull : colBear)

    table.cell(t, 0, 0, "VELA " + str.tostring(tHour) + ":" + (tMin < 10 ? "0" : "") + str.tostring(tMin), text_color = color.white, text_size = size.small, bgcolor = color.new(#2b4bf2, 15))
    table.cell(t, 1, 0, "→ 5 min", text_color = color.white, text_size = size.small, bgcolor = color.new(#2b4bf2, 15))

    table.cell(t, 0, 1, "Dirección", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 1, dirTxt, text_color = dirCol, text_size = size.small)

    table.cell(t, 0, 2, "Cierre (entrada)", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 2, na(vClose) ? "—" : str.tostring(vClose, format.mintick), text_color = color.white, text_size = size.small)

    table.cell(t, 0, 3, "TP objetivo", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 3, na(vTp) ? "—" : str.tostring(vTp, format.mintick), text_color = dirCol, text_size = size.small)

// ══ AVISO SI EL GRÁFICO NO ESTÁ EN 5 MIN ═════════════════════
var label warnLbl = na
if barstate.islast and not is5min
    label.delete(warnLbl)
    warnLbl := label.new(bar_index, high, "⚠  Pon el gráfico en 5 min", style = label.style_label_down, color = color.orange, textcolor = color.black, size = size.small)
